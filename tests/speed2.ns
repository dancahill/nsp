#!/usr/bin/nsp

function test1() {
	table = {};
	printf("\e[01;37;40m%s\e[00m\r\n", "test1");
	oldtime = lib.debug.runtime();
	for (i = 0; i < 1024 * 20; i++) {
		table[i] = i;
		if (i % 1000 == 0) {
			print("" + i + "");
			t = lib.debug.runtime() - oldtime;
			oldtime = lib.debug.runtime();
			print("\t", lib.string.sub("      " + lib.math.floor(t * 1000), -7), "ms\t");
			if (lib.string.sub(_ostype_, 0, 7) != "Windows") {
				system("ps aux | grep [n]sp | grep -v grep > /tmp/ps.txt");
				x = lib.file.readall("/tmp/ps.txt");
				x = lib.string.replace(x, "\n", "");
				print("[", x, "]\n");
				lib.file.unlink("/tmp/ps.txt");
			}
			lib.io.flush();
		}
	}
	table = {};
	return;
}
function test2() {
	table = {
		y = 1;
		x = {};
	};
	printf("\e[01;37;40m%s\e[00m\r\n", "test2");
	oldtime = lib.debug.runtime();
	for (i = 1; i < 20001; i++) {
		table['x'][i] = { testdata1 = "x" * 512, testdata2 = "x" * 512 };
		if (i % 1000 == 0) {
			print("" + i + "");
			t = lib.debug.runtime() - oldtime;
			oldtime = lib.debug.runtime();
			print("\t", lib.string.sub("      " + lib.math.floor(t * 1000), -7), "ms\t");
			if (lib.string.sub(_ostype_, 0, 7) != "Windows") {
				system("ps aux | grep [n]sp | grep -v grep > /tmp/ps.txt");
				x = lib.file.readall("/tmp/ps.txt");
				x = lib.string.replace(x, "\n", "");
				print("[", x, "]\n");
				lib.file.unlink("/tmp/ps.txt");
			}
			lib.io.flush();
		}
	}
	table = {};
	print(lib.text.serialize(table));
	print("\n");
	return;
}

if (lib.string.sub(_ostype_, 0, 7) != "Windows") system("clear");

test1();
test2();

if (lib.string.sub(_ostype_, 0, 7) != "Windows") system("ps aux | grep [n]nsp | grep -v grep");
if (typeof (lib.io.gets) == 'function' && lib.string.sub(_ostype_, 0, 7) == "Windows") {
	print("\ndone - press enter\n");
	lib.io.gets();
}
if (meminfo) print(serialize(meminfo()));
